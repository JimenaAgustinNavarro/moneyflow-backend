# Configuración General
NODE_ENV=development
TIMEZONE=America/Lima

# API Gateway (HTTP)
GATEWAY_PORT=3000
CORS_ORIGIN=http://localhost:3001

# Core Service (TCP)
CORE_TCP_HOST=127.0.0.1
CORE_TCP_PORT=3002
INTERNAL_TCP_SECRET=reemplazar_con_secreto_hmac_tcp_interno_de_al_menos_32_caracteres

# Base de Datos (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/moneyflow_dev?schema=public

# Autenticación y JWT
JWT_SECRET=reemplazar_con_clave_secreta_de_al_menos_32_caracteres
JWT_EXPIRATION_TIME=1d
JWT_REFRESH_SECRET=reemplazar_con_clave_secreta_refresh_de_al_menos_32_caracteres
JWT_REFRESH_EXPIRATION_TIME=7d
