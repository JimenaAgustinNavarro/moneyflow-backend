generator client {
  provider     = "prisma-client"
  output       = "../apps/core-service/src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum AuthTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET

  @@map("auth_token_type")
}

enum AuthAuditEvent {
  REGISTER
  LOGIN_SUCCESS
  LOGIN_FAILED
  LOGOUT
  SESSION_REVOKED
  EMAIL_VERIFIED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  PASSWORD_CHANGED

  @@map("auth_audit_event")
}

model User {
  id                String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email             String         @unique @db.VarChar(255)
  passwordHash      String         @map("password_hash")
  fullName          String         @map("full_name") @db.VarChar(150)
  preferredCurrency String         @default("PEN") @map("preferred_currency") @db.VarChar(3)
  timezone          String         @default("America/Lima") @db.VarChar(64)
  emailVerifiedAt   DateTime?      @map("email_verified_at") @db.Timestamptz(6)
  isActive          Boolean        @default(true) @map("is_active")
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  sessions          UserSession[]
  authTokens        AuthToken[]
  auditLogs         AuthAuditLog[]

  @@map("users")
}

model UserSession {
  id                  String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId              String        @map("user_id") @db.Uuid
  familyId            String        @map("family_id") @db.Uuid
  refreshTokenHash    String        @unique @map("refresh_token_hash") @db.VarChar(128)
  expiresAt           DateTime      @map("expires_at") @db.Timestamptz(6)
  revokedAt           DateTime?     @map("revoked_at") @db.Timestamptz(6)
  replacedBySessionId String?       @map("replaced_by_session_id") @db.Uuid
  ipAddress           String?       @map("ip_address") @db.VarChar(64)
  userAgent           String?       @map("user_agent")
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user                User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBySession   UserSession?  @relation("SessionReplacement", fields: [replacedBySessionId], references: [id], onDelete: SetNull)
  replacedSessions    UserSession[] @relation("SessionReplacement")

  @@index([userId], map: "user_sessions_user_id_idx")
  @@index([familyId], map: "user_sessions_family_id_idx")
  @@index([expiresAt], map: "user_sessions_expires_at_idx")
  @@map("user_sessions")
}

model AuthToken {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String        @map("user_id") @db.Uuid
  type      AuthTokenType
  tokenHash String        @unique @map("token_hash") @db.VarChar(128)
  expiresAt DateTime      @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime?     @map("used_at") @db.Timestamptz(6)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type], map: "auth_tokens_user_id_type_idx")
  @@index([expiresAt], map: "auth_tokens_expires_at_idx")
  @@map("auth_tokens")
}

model AuthAuditLog {
  id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String?        @map("user_id") @db.Uuid
  event     AuthAuditEvent
  ipAddress String?        @map("ip_address") @db.VarChar(64)
  userAgent String?        @map("user_agent")
  requestId String?        @map("request_id") @db.VarChar(128)
  metadata  Json?          @db.JsonB
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  user      User?          @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)], map: "auth_audit_logs_user_id_created_at_idx")
  @@index([event, createdAt(sort: Desc)], map: "auth_audit_logs_event_created_at_idx")
  @@map("auth_audit_logs")
}
